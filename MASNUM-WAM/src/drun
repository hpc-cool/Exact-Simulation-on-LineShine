n2m=\$(echo \$(cat /sys/devices/system/node/node{1[6-9],[23][0-9]}/hugepages/hugepages-2048kB/nr_hugepages))
#n64k=\$(echo \$(cat /sys/devices/system/node/node{1[6-9],[23][0-9]}/hugepages/hugepages-64kB/nr_hugepages))
echo "\$s" 
printf "%s %5d/%5d hpg:%s\n" \$hn \$OMPI_COMM_WORLD_RANK \$OMPI_COMM_WORLD_SIZE "\$n1g:\$n32m:\$n2m"
#for n in \$a;do
#  if (( \$n < 3072 )) ;then
#    printf "%s ====Err==== %4d / %4d hbm:%s\n" \$hn \$OMPI_COMM_WORLD_RANK \$OMPI_COMM_WORLD_SIZE  "\$a"
#    sleep 1000
#    exit
#  fi
#done
fi
echo \$hn \$OMPI_COMM_WORLD_RANK begin: \$(date +%T)
$EXE 
EOF

