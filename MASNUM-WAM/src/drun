#!/bin/bash
EXE=./nwam_xharm2
QUE=q_eapp
QUE=q_genuser
QUE=q_ky_debug
QUE=q_zw
QUE=q_ky_perf1
NN=1;NPPN=16 
[  -z $1 ] || NN=$1
[  -z $2 ] || NPPN=$2

NCPN=$( sed -n  "s/^ *NCluPNode *= *\([0-9]*\) *,/\1/p"  nwamctl.ini)
if (( ${#NPPN}>=1 ));then
  NGPP=$(( $NCPN/$NPPN ))
  #modify nwamctl.ini
  sed -i "s/^\( * *NGrpPProc *= *\)[0-9]*/\1$NGPP/;s/^\( * *NProcPNode *= *\)[0-9]*/\1$NPPN/;" nwamctl.ini
else
  #read from nwamctl.ini
  NGPP=$( sed -n  "s/^ *NGrpPProc *= *\([0-9]*\) *,/\1/p"   nwamctl.ini)
  NPPN=$( sed -n "s/^ *NProcPNode *= *\([0-9]*\) *,/\1/p"  nwamctl.ini)
fi
if (( $NGPP * $NPPN >$NCPN ));then
  echo "Error NGrpPProc($NGPP) * NProcPNode($NPPN) > NCluPNode($NCPN)"
  exit
fi
NP=$(( $NN*$NPPN ))
if (( $NPPN<=16 )) ;then
  NGPP=$(( 16/$NPPN ))
  NCPP=$(( 38*$NGPP ))
else
  NCPP=1;NCPC=36;
fi
if (( $NP < 2 ));then
  echo "Not surport 1 Proc,please use NO_MPI version"
  exit
fi

id=${NN}_${NPPN}

cat <<EOF >runcmd$id
