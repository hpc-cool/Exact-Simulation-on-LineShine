/work_ssd/software/performance_tune/root_proxy set_cpu_frequency.sh 0-607 1.55GHz quiet
a=\$(echo \$(numactl -H|grep -E "node (1[6-9]|[23][0-9]).*free:"|sed "s/node ..//g;s/free://g;s/MB//g"))
s=\$(printf "%s %5d/%5d hbm:%s\n" \$hn \$OMPI_COMM_WORLD_RANK \$OMPI_COMM_WORLD_SIZE  "\$a")
