#define DTD  
#define SYNCA
#define SYNCB
#define SYNCC



#define ZDO_2D(L, R, B, T)  DO_2D(L, R, B, T) 
#define ZDO_2D_OVR(L, R, B, T) DO_2D_OVR(L, R, B, T) 

#define ZDO_3D(L, R, B, T, ks, ke) DO_3D(L, R, B, T, ks, ke)
#define ZDO_3D_OVR(L, R, B, T, ks, ke) DO_3D_OVR(L, R, B, T, ks, ke)
#define ZDO_3DS(L, R, B, T, ks, ke, ki) DO_3DS(L, R, B, T, ks, ke, ki)
#define ZDO_3DS_OVR(L, R, B, T, ks, ke, ki) DO_3DS_OVR(L, R, B, T, ks, ke, ki)

