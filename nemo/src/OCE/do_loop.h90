#define JDO_3D(L, R, B, T, ks, ke) DO_3D(L, R, B, T, ks, ke)
#define JDO_3D_OVR(L, R, B, T, ks, ke) DO_3D_OVR(L, R, B, T, ks, ke)
#define JDO_3DS(L, R, B, T, ks, ke, ki) DO_3DS(L, R, B, T, ks, ke, ki)
#define JDO_3DS_OVR(L, R, B, T, ks, ke, ki) DO_3DS_OVR(L, R, B, T, ks, ke, ki)
#define JEND_2D  END_2D
#define JEND_3D  END_3D



