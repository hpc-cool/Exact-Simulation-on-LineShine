#define YDO_3D_OVR(L, R, B, T, ks, ke) DO_3D_OVR(L, R, B, T, ks, ke)
#define YDO_3DS(L, R, B, T, ks, ke, ki) DO_3DS(L, R, B, T, ks, ke, ki)
#define YDO_3DS_OVR(L, R, B, T, ks, ke, ki) DO_3DS_OVR(L, R, B, T, ks, ke, ki)
#define YEND_2D  END_2D
#define YEND_3D  END_3D


#define IDO_2D(L, R, B, T)  DO_2D(L, R, B, T) 
