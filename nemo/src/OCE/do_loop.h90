#define IDO_3D(L, R, B, T, ks, ke) DO_3D(L, R, B, T, ks, ke)
#define IDO_3D_OVR(L, R, B, T, ks, ke) DO_3D_OVR(L, R, B, T, ks, ke)
#define IDO_3DS(L, R, B, T, ks, ke, ki) DO_3DS(L, R, B, T, ks, ke, ki)
#define IDO_3DS_OVR(L, R, B, T, ks, ke, ki) DO_3DS_OVR(L, R, B, T, ks, ke, ki)
#define IEND_2D  END_2D
#define IEND_3D  END_3D



#define JDO_2D(L, R, B, T)  DO_2D(L, R, B, T) 
